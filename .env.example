# ==========================================
# EXPERT DIAGNOSTIC ENGINE CONFIGURATION
# ==========================================

# 1. Routing & Domain
# The external domain where the UI will be accessible via Traefik
DOMAIN=expert.yourdomain.com

# 2. External Database
# Connection details for your external PostgreSQL 18 instance
POSTGRES_HOST=db.yourdomain.com
POSTGRES_USER=expert
POSTGRES_DB=expert

# 3. Frontend Internal Configuration
# Internal routing for the frontend to reach the FastAPI backend
# (Do not change this unless you are modifying the Docker network topology)
INTERNAL_API_URL=http://expert-backend:8000
NODE_ENV=production
